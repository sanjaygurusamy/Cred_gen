# CampusCarbon AI Configuration

# LLM Provider Configuration (OpenAI, Compatible, or fallback)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=15
LLM_ENABLE_CACHE=true

# Database Configuration (SQLite default for zero-friction setup)
DATABASE_URL=sqlite:///./campus_carbon.db

# Server Configuration
PORT=8000
HOST=127.0.0.1
DEBUG=true

# Application Security
SECRET_KEY=change-this-in-production-campus-carbon-secret-key
DEFAULT_CAMPUS_ID=green-tech-univ-01
