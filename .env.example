# ==============================================================================
# CampusCarbon AI — Environment Configuration Template
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=true
APP_NAME="CampusCarbon AI"
APP_VERSION="2.0.0"

# Backend Server
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
SECRET_KEY=change-in-production-campus-carbon-secure-key-32chars

# Database Configuration (PostgreSQL 16)
POSTGRES_USER=campuscarbon
POSTGRES_PASSWORD=campuscarbon_dev_password
POSTGRES_DB=campuscarbon_db
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://campuscarbon:campuscarbon_dev_password@127.0.0.1:5432/campuscarbon_db

# Frontend
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1

# AI / LLM Configuration (Optional Contextual Layer — offline fallback active by default)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=15
LLM_ENABLE_CACHE=true

# Institutional Defaults
DEFAULT_CAMPUS_ID=green-tech-univ-01
DEFAULT_CAMPUS_CODE=GTU-MAIN
